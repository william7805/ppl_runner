# Base PostgreSQL locale (Docker Compose)
POSTGRES_USER=ppl_runner
POSTGRES_PASSWORD=change_me
POSTGRES_DB=ppl_runner

# URL de connexion utilisée par l'application et Drizzle
# En local : pointe vers le conteneur Docker
# En production : définie dans Vercel et dans les secrets GitHub, jamais ici
DATABASE_URL=postgresql://ppl_runner:change_me@localhost:5432/ppl_runner