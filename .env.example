# Base PostgreSQL locale (Docker Compose)
POSTGRES_USER=ppl_runner
POSTGRES_PASSWORD=change_me
POSTGRES_DB=ppl_runner

# URL de connexion utilisée par l'application et Drizzle
# En local : pointe vers le conteneur Docker
# En production : définie dans Vercel et dans les secrets GitHub, jamais ici
DATABASE_URL=postgresql://ppl_runner:change_me@localhost:5432/ppl_runner

# Authentification (Better Auth)
# Génère un secret avec : npx @better-auth/cli@latest secret
BETTER_AUTH_SECRET=change_me_32_caracteres_minimum
BETTER_AUTH_URL=http://localhost:3001
# Autorise la création de compte. À mettre à true uniquement le temps de
# créer ton compte, jamais en production de façon permanente.
AUTH_ALLOW_SIGNUP=false